<span
  style="
    color: transparent;
    display: none;
    height: 0;
    max-height: 0;
    max-width: 0;
    opacity: 0;
    overflow: hidden;
    mso-hide: all;
    visibility: hidden;
    width: 0;
  "
  >Your requested <%= report_name %> is ready for download.</span
>
<%- include('./includes/header.ejs') %>

<table
  role="presentation"
  border="0"
  cellpadding="0"
  cellspacing="0"
  style="width: 100%; border-collapse: collapse"
>
  <tr>
    <td
      style="
        padding: 24px 0 16px 0;
        font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
        font-size: 16px;
        line-height: 24px;
        color: #333333;
      "
    >
      <p style="margin: 0 0 16px 0; font-weight: 500">
        Hello <%= first_name %>,
      </p>
      <p style="margin: 0 0 24px 0; color: #555555">
        Your requested **<%= report_name %>** has been generated successfully.
        The data processing loop has finished running, and your compiled
        document is ready for download.
      </p>
    </td>
  </tr>

  <tr>
    <td align="left" style="padding: 0 0 32px 0">
      <table
        role="presentation"
        border="0"
        cellpadding="0"
        cellspacing="0"
        style="border-collapse: separate"
      >
        <tr>
          <td
            align="center"
            style="background-color: #0066cc; border-radius: 4px"
          >
            <a
              href="<%= file_url %>"
              target="_blank"
              style="
                display: inline-block;
                padding: 12px 24px;
                font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
                font-size: 15px;
                font-weight: bold;
                color: #ffffff;
                text-decoration: none;
                border-radius: 4px;
                letter-spacing: 0.5px;
              "
            >
              Download Report
            </a>
          </td>
        </tr>
      </table>
    </td>
  </tr>

  <tr>
    <td
      style="
        padding: 0 0 24px 0;
        font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
        font-size: 13px;
        line-height: 20px;
        color: #777777;
        border-top: 1px solid #eef0f3;
        padding-top: 24px;
      "
    >
      <p style="margin: 0 0 8px 0">
        If the button above does not work, copy and paste this URL into your web
        browser:
      </p>
      <p style="margin: 0; color: #0066cc; word-break: break-all">
        <a
          href="<%= file_url %>"
          target="_blank"
          style="color: #0066cc; text-decoration: underline"
        >
          <%= file_url %>
        </a>
      </p>
      <p style="margin: 12px 0 0 0; font-style: italic; color: #999999">
        Note: For data safety and security, this export download link contains a
        temporary lifecycle constraint.
      </p>
    </td>
  </tr>
</table>

<%- include('./includes/footer.ejs') %>
