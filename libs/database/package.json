{
  "name": "@lib/database",
  "version": "1.0.0",
  "private": true,
  "main": "src/index.ts",
  "types": "src/index.ts",
  "scripts": {
    "db:generate": "drizzle-kit generate --config=./src/drizzle/drizzle.config.ts",
    "db:migrate": "drizzle-kit migrate --config=./src/drizzle/drizzle.config.ts",
    "db:studio": "drizzle-kit studio --config=./src/drizzle/drizzle.config.ts",
    "db:seed": "tsx src/drizzle/seeds/index.ts && tsx src/mongoose/seeds/index.ts",
    "db:seed:pg": "tsx src/drizzle/seeds/index.ts",
    "db:seed:mongo": "tsx src/mongoose/seeds/index.ts",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@10.30.3",
  "dependencies": {
    "@nestjs/common": "^11.1.19",
    "@nestjs/config": "^12.0.0",
    "@nestjs/mongoose": "^12.0.0",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "ioredis": "^5.10.1",
    "mongoose": "^9.11.2",
    "pg": "^8.20.0",
    "uuid": "^14.0.0",
    "uuidv7": "^1.2.1"
  },
  "devDependencies": {
    "@types/pg": "^8.20.0",
    "drizzle-kit": "^0.31.10"
  }
}
