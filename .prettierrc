{
  "singleQuote": true,
  "trailingComma": "all",
  "plugins": ["@ianvs/prettier-plugin-sort-imports"],
  "importOrder": [
    "^@nestjs/(.*)$",
    "",
    "<THIRD_PARTY_MODULES>",
    "",
    "^@libs/database(.*)$",
    "^@libs/token(.*)$",
    "^@libs/common(.*)$",
    "^@libs/modules(.*)$",
    "^@libs/background-process(.*)$",
    "^@libs/(.*)$",
    "",
    "^@app/(.*)$",
    "",
    "^[./]"
  ],
  "importOrderTypeScriptVersion": "5.0.0",
  "importOrderParserPlugins": ["typescript", "decorators-legacy"]
}